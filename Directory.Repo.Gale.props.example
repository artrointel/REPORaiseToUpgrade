<Project>
  <PropertyGroup>
    <!-- Steam installation directory for R.E.P.O. Omit this if the SDK detects it automatically. -->
    <GameDirectory>C:\Program Files (x86)\Steam\steamapps\common\REPO</GameDirectory>

    <!-- Gale development profile. -->
    <ProfileName>Mod Dev</ProfileName>
    <BepInExDirectory>$(AppData)\com.kesomannen.gale\repo\profiles\$(ProfileName)\BepInEx</BepInExDirectory>
    <StartArguments>--doorstop-enable true --doorstop-target &quot;$(BepInExDirectory)\core\BepInEx.Preloader.dll&quot; --gale-profile &quot;$(ProfileName)&quot;</StartArguments>
  </PropertyGroup>
</Project>
