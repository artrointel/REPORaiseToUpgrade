<Project>
  <PropertyGroup>
    <!-- Steam의 R.E.P.O. 설치 폴더. SDK가 자동 감지하면 생략할 수 있습니다. -->
    <GameDirectory>C:\Program Files (x86)\Steam\steamapps\common\REPO</GameDirectory>

    <!-- r2modman 개발 프로필 설정 -->
    <ProfileName>Mod Dev</ProfileName>
    <BepInExDirectory>$(AppData)\r2modmanPlus-local\REPO\profiles\$(ProfileName)\BepInEx</BepInExDirectory>
    <StartArguments>--doorstop-enable true --doorstop-target &quot;$(BepInExDirectory)\core\BepInEx.Preloader.dll&quot;</StartArguments>

  </PropertyGroup>
</Project>

